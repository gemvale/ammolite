{
    "name": "ammolite",
    "version": "0.1.0",
    "description": "A CSS-in-JS library",
    "keywords": [
        "ammolite",
        "css",
        "css-in-js",
        "ts",
        "typescript",
        "js",
        "javascript"
    ],
    "homepage": "https://github.com/gemvale/ammolite",
    "bugs": "https://github.com/gemvale/ammolite/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/gemvale/ammolite.git",
        "directory": "packages/web"
    },
    "license": "MIT",
    "author": {
        "name": "Alpheus",
        "email": "contact@alphe.us"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./errors/transform": {
            "types": "./dist/errors/transform.d.ts",
            "import": "./dist/errors/transform.mjs",
            "require": "./dist/errors/transform.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "csstype": "^3.2.3",
        "html-tag-types": "~0.0.1",
        "ts-vista": "catalog:dep"
    }
}
