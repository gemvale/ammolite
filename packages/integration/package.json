{
    "name": "@ammolite/integration",
    "version": "0.1.0",
    "description": "An integration for Ammolite",
    "keywords": [
        "ammolite",
        "css",
        "css-in-js",
        "integration",
        "ts",
        "typescript",
        "js",
        "javascript"
    ],
    "homepage": "https://github.com/gemvale/ammolite",
    "bugs": "https://github.com/gemvale/ammolite/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/gemvale/ammolite.git",
        "directory": "packages/integration"
    },
    "license": "MIT",
    "author": {
        "name": "Alpheus",
        "email": "contact@alphe.us"
    },
    "exports": {
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.mjs",
            "require": "./dist/runtime/index.js"
        },
        "./filter": {
            "types": "./dist/filter/index.d.ts",
            "import": "./dist/filter/index.mjs",
            "require": "./dist/filter/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/runtime.js",
    "module": "./dist/runtime.mjs",
    "types": "./dist/runtime.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@ammolite/compiler": "workspace:~",
        "es-toolkit": "catalog:dep",
        "ts-vista": "catalog:dep"
    }
}
