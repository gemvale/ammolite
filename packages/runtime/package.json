{
    "name": "@ammolite/runtime",
    "version": "0.1.0",
    "description": "A CSS-in-JS runtime",
    "keywords": [
        "ammolite",
        "css",
        "css-in-js",
        "runtime",
        "ts",
        "typescript",
        "js",
        "javascript"
    ],
    "homepage": "https://github.com/gemvale/ammolite",
    "bugs": "https://github.com/gemvale/ammolite/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/gemvale/ammolite.git",
        "directory": "packages/runtime"
    },
    "license": "MIT",
    "author": {
        "name": "Alpheus",
        "email": "contact@alphe.us"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./helper": {
            "types": "./dist/helper.d.ts",
            "import": "./dist/helper.mjs",
            "require": "./dist/helper.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@ammolite/compiler": "workspace:~",
        "es-toolkit": "catalog:dep",
        "ts-vista": "catalog:dep"
    }
}
