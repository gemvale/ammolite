{
    "name": "@ammolite/next",
    "version": "0.1.4",
    "description": "A Next.js plugin for Ammolite",
    "keywords": [
        "ammolite",
        "css",
        "css-in-js",
        "next",
        "next.js",
        "plugin",
        "ts",
        "typescript",
        "js",
        "javascript"
    ],
    "homepage": "https://gemvale.github.io",
    "bugs": "https://github.com/gemvale/ammolite/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/gemvale/ammolite.git",
        "directory": "plugins/next"
    },
    "license": "MIT",
    "author": {
        "name": "Alpheus",
        "email": "contact@alphe.us"
    },
    "exports": {
        "./webpack": {
            "types": "./dist/webpack.d.ts",
            "import": "./dist/webpack.mjs",
            "require": "./dist/webpack.js"
        },
        "./turbopack": {
            "types": "./dist/turbopack.d.ts",
            "import": "./dist/turbopack.mjs",
            "require": "./dist/turbopack.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/webpack.js",
    "module": "./dist/webpack.mjs",
    "types": "./dist/webpack.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@ammolite/unplugin": "workspace:~",
        "ts-vista": "catalog:dep"
    },
    "devDependencies": {
        "next": "catalog:dev",
        "webpack": "catalog:dev"
    },
    "peerDependencies": {
        "next": "catalog:peer",
        "webpack": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        },
        "webpack": {
            "optional": true
        }
    }
}
