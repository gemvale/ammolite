{
    "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
    "name": "@ammolite/unplugin",
    "version": "0.1.5",
    "description": "A unified plugin for Ammolite",
    "keywords": [
        "ammolite",
        "css",
        "css-in-js",
        "unplugin",
        "plugin",
        "ts",
        "typescript",
        "js",
        "javascript"
    ],
    "homepage": "https://gemvale.github.io",
    "bugs": "https://github.com/gemvale/ammolite/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/gemvale/ammolite.git",
        "directory": "plugins/unplugin"
    },
    "license": "MIT",
    "author": {
        "name": "Alpheus",
        "email": "contact@alphe.us"
    },
    "exports": {
        ".": {
            "types": "./dist/rollup/index.d.ts",
            "import": "./dist/rollup/index.mjs",
            "require": "./dist/rollup/index.js"
        },
        "./webpack": {
            "types": "./dist/webpack/index.d.ts",
            "import": "./dist/webpack/index.mjs",
            "require": "./dist/webpack/index.js"
        },
        "./rspack": {
            "types": "./dist/rspack/index.d.ts",
            "import": "./dist/rspack/index.mjs",
            "require": "./dist/rspack/index.js"
        },
        "./rollup": {
            "types": "./dist/rollup/index.d.ts",
            "import": "./dist/rollup/index.mjs",
            "require": "./dist/rollup/index.js"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "import": "./dist/vite/index.mjs",
            "require": "./dist/vite/index.js"
        },
        "./webpack/create": {
            "types": "./dist/webpack/create.d.ts",
            "import": "./dist/webpack/create.mjs",
            "require": "./dist/webpack/create.js"
        },
        "./rspack/create": {
            "types": "./dist/rspack/create.d.ts",
            "import": "./dist/rspack/create.mjs",
            "require": "./dist/rspack/create.js"
        },
        "./rollup/create": {
            "types": "./dist/rollup/create.d.ts",
            "import": "./dist/rollup/create.mjs",
            "require": "./dist/rollup/create.js"
        },
        "./vite/create": {
            "types": "./dist/vite/create.d.ts",
            "import": "./dist/vite/create.mjs",
            "require": "./dist/vite/create.js"
        },
        "./webpack/loader": {
            "types": "./dist/webpack/loader.d.ts",
            "import": "./dist/webpack/loader.mjs",
            "require": "./dist/webpack/loader.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/rollup/index.js",
    "module": "./dist/rollup/index.mjs",
    "types": "./dist/rollup/index.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@ammolite/integration": "workspace:~",
        "es-toolkit": "catalog:dep",
        "ts-vista": "catalog:dep",
        "unplugin": "^3.0.0"
    },
    "devDependencies": {
        "@rspack/core": "catalog:dev",
        "rollup": "catalog:dev",
        "vite": "catalog:dev",
        "webpack": "catalog:dev"
    },
    "peerDependencies": {
        "@rspack/core": "catalog:peer",
        "rollup": "catalog:peer",
        "vite": "catalog:peer",
        "webpack": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "@rspack/core": {
            "optional": true
        },
        "rollup": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "webpack": {
            "optional": true
        }
    },
    "compatiblePackages": {
        "schemaVersion": 1,
        "rollup": {
            "type": "compatible",
            "versions": "^4.40.0"
        },
        "rolldown": {
            "type": "compatible",
            "versions": "^1.0.0"
        },
        "vite": {
            "type": "compatible",
            "versions": "^7.0.0 || ^8.0.0"
        }
    }
}
