{
    "name": "@ammolite/postcss",
    "version": "0.1.1",
    "description": "A PostCSS plugin for Ammolite",
    "keywords": [
        "ammolite",
        "css",
        "css-in-js",
        "postcss",
        "plugin",
        "ts",
        "typescript",
        "js",
        "javascript"
    ],
    "homepage": "https://gemvale.github.io",
    "bugs": "https://github.com/gemvale/ammolite/issues",
    "repository": {
        "type": "git",
        "url": "https://github.com/gemvale/ammolite.git",
        "directory": "plugins/postcss"
    },
    "license": "MIT",
    "author": {
        "name": "Alpheus",
        "email": "contact@alphe.us"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./create": {
            "types": "./dist/create.d.ts",
            "import": "./dist/create.mjs",
            "require": "./dist/create.js"
        },
        "./plugins/cache": {
            "types": "./dist/plugins/cache.d.ts",
            "import": "./dist/plugins/cache.mjs",
            "require": "./dist/plugins/cache.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@ammolite/integration": "workspace:~",
        "fdir": "catalog:dep",
        "ts-vista": "catalog:dep"
    },
    "devDependencies": {
        "postcss": "catalog:dev"
    },
    "peerDependencies": {
        "postcss": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "postcss": {
            "optional": true
        }
    }
}
